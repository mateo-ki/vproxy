#!/usr/bin/env bash
# 极致测试门禁（与 .github/workflows/ci.yml 对齐 + 本地加固）：
#   fmt --check → clippy -D warnings → check --no-default-features → cargo test
# 文档/scoop/.github/钩子脚本本身的改动免测；FORCE_FULL_GATE=1 强制全门。
set -uo pipefail

run_full=0
if [ "${FORCE_FULL_GATE:-}" = "1" ]; then
  run_full=1
else
  while IFS= read -r -d '' f; do
    case "$f" in
      *.md|*.txt|*.png|*.ico|.github/*|scoop/*|scripts/githooks/*) ;;
      *) run_full=1; break ;;
    esac
  done < <(git diff --cached --name-only -z --diff-filter=ACMR)
fi

if [ "$run_full" -eq 0 ]; then
  echo "⏭  仅文档/工具改动，跳过全量门禁"
  exit 0
fi

fail() { echo "✗ 提交被门禁拦截：$1"; exit 1; }

echo "==> [1/4] cargo fmt --all -- --check"
cargo fmt --all -- --check || fail "格式化未过：先跑 cargo fmt --all 再 git add"

echo "==> [2/4] cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings || fail "clippy 未过"

echo "==> [3/4] cargo check --no-default-features（无头编译门）"
cargo check --no-default-features || fail "无头编译门未过"

echo "==> [4/4] cargo test"
# 已知环境竞态：并行链接时 AV 实时扫描间歇性抢占 PDB 写入（LNK1201/1104）
cargo test || {
  echo "    链接竞态/失败，10 秒后自动重试一次…"
  sleep 10
  cargo test || fail "测试未过（重试后仍失败）"
}

echo "✓ 极致测试门禁全部通过"
